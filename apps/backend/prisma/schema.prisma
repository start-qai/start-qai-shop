// Prisma schema – SQLite database runs locally both in Docker and with manual npm.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id
  title       String
  description String
  price       Float
  currency    String   @default("PLN")
  imageUrl    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String   @default("demo")
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model Order {
  id             String   @id @default(cuid())
  /// PAID | SHIPPED | DELIVERED (gRPC: ORDER_STATUS_*)
  status         String   @default("PAID")
  totalPrice     Float
  currency       String   @default("PLN")
  /// Snapshot of the cart items at checkout time.
  itemsJson      String
  trackingNumber String?
  createdAt      DateTime @default(now())
  /// @default(now()) lets `prisma db push` add the column to an existing database without data loss.
  updatedAt      DateTime @default(now()) @updatedAt
}
