# ---- Backend ----
# Port serwera API (Swagger dostępny pod http://localhost:PORT/docs)
PORT=4000

# Ścieżka do bazy SQLite (Prisma)
DATABASE_URL="file:./prisma/dev.db"

# Zahardkodowany token symulujący autoryzację.
# Ten sam token używany jest przez frontend oraz w requestach HTTP (nagłówek Authorization: Bearer <token>).
# Każdy inny token => 401.
DEMO_AUTH_TOKEN=qai-shop-demo-token-2026

# Dane logowania akceptowane przez /api/auth/login (symulacja, brak prawdziwego OAuth)
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123

# Adres frontendu (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# ---- Frontend ----
# Adres backendu widziany przez przeglądarkę
VITE_API_URL=http://localhost:4000
